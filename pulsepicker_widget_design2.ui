}

QLabel {
    color: #2C3E50;
    background-color: transparent;
}

QPushButton {
    background-color: #4A90E2;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #357ABD;
}

QPushButton:pressed {
    background-color: #2E6DA4;
}

QLineEdit, PyDMLineEdit {
    background-color: white;
    border: 1px solid #C0C0C0;
    border-radius: 3px;
    padding: 3px;
    color: #2C3E50;
}

PyDMLabel {
    background-color: white;
    border: 1px solid #C0C0C0;
    border-radius: 3px;
    padding: 3px;
    color: #2C3E50;
}</string>
